{
  "backend": "winui3",
  "_doc": "Agnostic third-party control registry. Auto-loaded from any *.json next to winuic.exe. Covers both XAML TemplatedControls (with ResourceDictionary templates) and pure C++/WinRT components. No language is hardcoded — the .winmd is projection-agnostic and downstream projections (cppwinrtc, pywinrtc, winrs, etc.) handle language-specific codegen. Built-in WinUI 3 controls (Grid, Button, TextBlock, etc.) are compiled in — only register controls NOT in the built-in registry.",
  "_schema": {
    "abstract_name": "Name used in .winui source (required)",
    "platform_type": "WinRT class name to instantiate (required)",
    "platform_namespace": "Full WinRT namespace",
    "type": "xaml = XAML TemplatedControl with ResourceDictionary; cpp = pure C++/WinRT component (default: cpp)",
    "accepts_children": "bool — can hold child elements (default: false)",
    "composition_kind": "how children attach on the platform: panel | content | items | items_panel | navigation | navigation_item | documents | blocks | popup | keyboard | icon_source | columns | charts (default: inferred from accepts_children → content)",
    "accepts_text_content": "bool — can hold inline text (default: false)",
    "category": "layout | content | input | navigation | collections | menus | feedback | flyout | dialog | custom",
    "fixed_properties": "[{name, value}] — always set on the control",
    "properties": "[{abstract_name, platform_setter, transform, type}] — named arguments",
    "events": "[{abstract_name, platform_event}] — .onX { } closures",
    "template_resource_key": "x:Key in ResourceDictionary (xaml controls only)",
    "resource_dictionary": "relative path to .xaml in package (xaml controls only)",
    "_note": "Downstream projection reads 'type' to emit ResourceDictionary merge (xaml) or direct instantiation (cpp). The .winmd carries no language-specific code.",
    "_transforms": "double | int | box | brush | thickness | corner_radius | enum | symbol | font_weight | visibility | nullable_bool | datetime | uri | geopoint"
  },
  "xamlEvents": [ "Sorted", "Sorting", "ElementClearing", "ElementAdding", "ElementExposed", "ElementPrepared" ],
  "controls": [

    {
